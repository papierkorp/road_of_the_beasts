[ext_resource type="Script" path="res://battle/defs/tamer_skill_def.gd" id="1_seal0"]

[resource]
script = ExtResource("1_seal0")
id = &"seal_epic"
display_name = "Epic Seal"
effect = "seal"
description = "Seal item, used up when laid. Lay Seal Ground on a square: a wild monster that ends its turn on it is caught with a chance (50% at 1 HP, 10 points less per further HP); one that falls to 0 HP on it is caught for sure."
seal_base = 50
seal_item = true
