[resource]
script = ExtResource("1")
id = &"pill_binding"
display_name = "Binding Pill"
effect = "seal"
description = "A square becomes Seal Ground: a wild monster that ends its turn on it is caught with a chance (50% at 1 HP, 10 points less per further HP); one that falls to 0 HP on it is caught for sure."
source = "pill"
