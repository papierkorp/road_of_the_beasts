[resource]
script = ExtResource("3_sd")
id = &"raise_wall"
display_name = "Earth Wall"
kind = "ground"
description = "Raises three Earth Walls in a line on free squares within Reach: solid, 2 HP each."
status = "test data (prop rework 2026-11-14, no GDD record)"
ap_cost = 2
footprint = Array[Vector2i]([Vector2i(-1, 0), Vector2i(0, 0), Vector2i(1, 0)])
board_ops = Array[ExtResource("1_bo")]([SubResource("Resource_prop")])
