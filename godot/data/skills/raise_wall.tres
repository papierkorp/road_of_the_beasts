[ext_resource type="Script" path="res://battle/defs/field_effect.gd" id="2_fe"]
[ext_resource type="Script" path="res://battle/defs/battle_skill_def.gd" id="3_sd"]

[sub_resource type="Resource" id="Resource_prop"]
script = ExtResource("1_bo")
