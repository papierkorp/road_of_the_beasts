[resource]
script = ExtResource("1")
id = &"way_of_the_beast_lord"
display_name = "Way of the Beast Lord"
blurb = "Your monsters are the way. Pack: fight wide with many. Champion: carry one monster far."
branches = [{"id": "pack", "name": "Pack", "text": "fight wide"}, {"id": "champion", "name": "Champion", "text": "carry one monster"}]
nodes = [{"id": &"swap_places", "stage": 0, "name": "Swap Places", "kind": "tamer", "ref": &"swap_places", "cost": 1, "needs": &"", "branch": "pack"}, {"id": &"urgent_order", "stage": 1, "name": "Urgent Order", "kind": "tamer", "ref": &"urgent_order", "cost": 1, "needs": &"", "branch": "pack"}, {"id": &"beast_swap", "stage": 1, "name": "Beast Swap", "kind": "tamer", "ref": &"beast_swap", "cost": 2, "needs": &"swap_places", "branch": "pack"}, {"id": &"second_wind", "stage": 0, "name": "Second Wind", "kind": "tamer", "ref": &"second_wind", "cost": 1, "needs": &"", "branch": "champion"}, {"id": &"spirit_shield", "stage": 1, "name": "Spirit Shield", "kind": "tamer", "ref": &"spirit_shield", "cost": 1, "needs": &"", "branch": "champion"}, {"id": &"life_thread", "stage": 1, "name": "Life Thread", "kind": "tamer", "ref": &"life_thread", "cost": 2, "needs": &"second_wind", "branch": "champion"}]
