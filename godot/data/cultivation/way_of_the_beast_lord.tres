[gd_resource type="Resource" script_class="CultivationDef" format=3]

[ext_resource type="Script" path="res://overworld/core/cultivation_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"way_of_the_beast_lord"
display_name = "Way of the Beast Lord"
blurb = "Your monsters are the way. Pack: fight wide with many. Champion: carry one monster far."
branches = [{"id": "pack", "name": "Pack", "text": "fight wide"}, {"id": "champion", "name": "Champion", "text": "carry one monster"}]
nodes = [{"id": &"wider_nest", "stage": 0, "name": "Wider Nest", "kind": "perk", "ref": &"", "cost": 1, "needs": &"", "branch": "pack", "text": "Your roster holds 2 more.", "effects": {"roster": 2}}, {"id": &"swap_places", "stage": 0, "name": "Swap Places", "kind": "tamer", "ref": &"swap_places", "cost": 1, "needs": &"", "branch": "pack"}, {"id": &"urgent_order", "stage": 1, "name": "Urgent Order", "kind": "tamer", "ref": &"urgent_order", "cost": 1, "needs": &"", "branch": "pack"}, {"id": &"shared_growth", "stage": 1, "name": "Shared Growth", "kind": "perk", "ref": &"", "cost": 2, "needs": &"wider_nest", "branch": "pack", "text": "Monsters of your roster that did not fight gain half the XP of a won battle.", "effects": {"bench_xp": 50}}, {"id": &"second_wind", "stage": 0, "name": "Second Wind", "kind": "tamer", "ref": &"second_wind", "cost": 1, "needs": &"", "branch": "champion"}, {"id": &"lone_hunt", "stage": 0, "name": "Lone Hunt", "kind": "perk", "ref": &"", "cost": 1, "needs": &"", "branch": "champion", "text": "A monster that wins a battle alone gains half as much XP again.", "effects": {"solo_xp": 50}}, {"id": &"spirit_shield", "stage": 1, "name": "Spirit Shield", "kind": "tamer", "ref": &"spirit_shield", "cost": 1, "needs": &"", "branch": "champion"}, {"id": &"life_thread", "stage": 1, "name": "Life Thread", "kind": "tamer", "ref": &"life_thread", "cost": 2, "needs": &"second_wind", "branch": "champion"}]
