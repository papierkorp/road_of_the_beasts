nodes = [{"id": &"spike_trap", "stage": 0, "name": "Blueprint: Spike Trap", "kind": "blueprint", "ref": &"prop:spike_trap", "cost": 1, "needs": &"", "branch": "hazard"}, {"id": &"thornbed", "stage": 0, "name": "Blueprint: Thornbed", "kind": "blueprint", "ref": &"ground:thornbed", "cost": 1, "needs": &"", "branch": "hazard"}, {"id": &"lava", "stage": 1, "name": "Blueprint: Lava", "kind": "blueprint", "ref": &"ground:lava", "cost": 2, "needs": &"spike_trap", "branch": "hazard"}, {"id": &"vortex_trap", "stage": 1, "name": "Blueprint: Vortex Trap", "kind": "blueprint", "ref": &"prop:vortex_trap", "cost": 1, "needs": &"", "branch": "hazard"}, {"id": &"dragon_vein", "stage": 0, "name": "Blueprint: Dragon Vein", "kind": "blueprint", "ref": &"ground:dragon_vein", "cost": 1, "needs": &"", "branch": "bulwark"}, {"id": &"earth_wall", "stage": 0, "name": "Blueprint: Earth Wall", "kind": "blueprint", "ref": &"prop:earth_wall", "cost": 1, "needs": &"", "branch": "bulwark"}, {"id": &"push_zone", "stage": 1, "name": "Blueprint: Push Zone", "kind": "blueprint", "ref": &"zone:push_zone", "cost": 1, "needs": &"", "branch": "bulwark"}, {"id": &"wide_ground", "stage": 1, "name": "Wide Ground", "kind": "perk", "ref": &"", "cost": 1, "needs": &"", "branch": "bulwark", "text": "3 more budget for your battleground.", "effects": {"bg_budget": 3}}, {"id": &"domain_glimpse", "stage": 1, "name": "Domain Glimpse", "kind": "tamer", "ref": &"domain_glimpse", "cost": 1, "needs": &"", "branch": "bulwark"}]
