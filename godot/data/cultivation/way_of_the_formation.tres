nodes = [{"id": &"thorn_field", "stage": 0, "name": "Thorn Field", "kind": "tamer", "ref": &"thorn_field", "cost": 1, "needs": &"", "branch": "hazard"}, {"id": &"root_snare", "stage": 0, "name": "Root Snare", "kind": "tamer", "ref": &"root_snare", "cost": 1, "needs": &"", "branch": "hazard"}, {"id": &"ember_line", "stage": 1, "name": "Ember Line", "kind": "tamer", "ref": &"ember_line", "cost": 2, "needs": &"thorn_field", "branch": "hazard"}, {"id": &"stone_wall", "stage": 0, "name": "Stone Wall", "kind": "tamer", "ref": &"stone_wall", "cost": 1, "needs": &"", "branch": "bulwark"}, {"id": &"domain_glimpse", "stage": 1, "name": "Domain Glimpse", "kind": "tamer", "ref": &"domain_glimpse", "cost": 1, "needs": &"", "branch": "bulwark"}]
