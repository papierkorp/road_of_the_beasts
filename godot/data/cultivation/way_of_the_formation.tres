[gd_resource type="Resource" script_class="CultivationDef" format=3]

[ext_resource type="Script" path="res://overworld/core/cultivation_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"way_of_the_formation"
display_name = "Way of the Formation"
blurb = "You act in the battle yourself: tamer skills, once per battle each, that lay and clear squares or order your monsters. The larger battles of the wild give you Insight. You have no battleground of your own and no pills."
branches = [{"id": "hazard", "name": "Hazard", "text": "ground, walls and traps laid in the battle"}, {"id": "command", "name": "Command", "text": "your monsters: places, order, a second breath"}]
nodes = [{"id": &"thorn_field", "stage": 0, "name": "Thorn Field", "kind": "tamer", "ref": &"thorn_field", "cost": 1, "needs": &"", "branch": "hazard"}, {"id": &"stone_wall", "stage": 0, "name": "Stone Wall", "kind": "tamer", "ref": &"stone_wall", "cost": 1, "needs": &"", "branch": "hazard"}, {"id": &"root_snare", "stage": 1, "name": "Root Snare", "kind": "tamer", "ref": &"root_snare", "cost": 1, "needs": &"", "branch": "hazard"}, {"id": &"ember_line", "stage": 1, "name": "Ember Line", "kind": "tamer", "ref": &"ember_line", "cost": 2, "needs": &"thorn_field", "branch": "hazard"}, {"id": &"domain_glimpse", "stage": 2, "name": "Domain Glimpse", "kind": "tamer", "ref": &"domain_glimpse", "cost": 2, "needs": &"", "branch": "hazard"}, {"id": &"swap_places", "stage": 0, "name": "Swap Places", "kind": "tamer", "ref": &"swap_places", "cost": 1, "needs": &"", "branch": "command"}, {"id": &"second_wind", "stage": 0, "name": "Second Wind", "kind": "tamer", "ref": &"second_wind", "cost": 1, "needs": &"", "branch": "command"}, {"id": &"urgent_order", "stage": 1, "name": "Urgent Order", "kind": "tamer", "ref": &"urgent_order", "cost": 1, "needs": &"", "branch": "command"}, {"id": &"spirit_shield", "stage": 1, "name": "Spirit Shield", "kind": "tamer", "ref": &"spirit_shield", "cost": 1, "needs": &"", "branch": "command"}, {"id": &"life_thread", "stage": 2, "name": "Life Thread", "kind": "tamer", "ref": &"life_thread", "cost": 2, "needs": &"second_wind", "branch": "command"}, {"id": &"beast_swap", "stage": 3, "name": "Beast Swap", "kind": "tamer", "ref": &"beast_swap", "cost": 2, "needs": &"swap_places", "branch": "command"}]
