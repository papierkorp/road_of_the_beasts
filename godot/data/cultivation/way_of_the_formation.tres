[resource]
script = ExtResource("1")
id = &"way_of_the_formation"
display_name = "Way of the Formation"
blurb = "The ground fights for you: tamer skills that lay and clear the board in any battle. Hazard: ground that harms. Bulwark: walls and clearing."
