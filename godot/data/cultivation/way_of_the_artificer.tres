[gd_resource type="Resource" script_class="CultivationDef" format=3]

[ext_resource type="Script" path="res://overworld/core/cultivation_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"way_of_the_artificer"
display_name = "Way of the Artificer"
blurb = "You fight with tools of your own. Blade: the weapons of the forge. Cauldron: pills taken in the battle."
branches = [{"id": "blade", "name": "Blade", "text": "the weapons of the forge"}, {"id": "cauldron", "name": "Cauldron", "text": "pills taken in the battle"}]
nodes = [{"id": &"weapon_rack", "stage": 0, "name": "Weapon Rack", "kind": "perk", "ref": &"", "cost": 2, "needs": &"", "branch": "blade", "text": "One more tamer slot that only a weapon fills.", "effects": {"weapon_slot": 1}}, {"id": &"scrap_sense", "stage": 0, "name": "Scrap Sense", "kind": "perk", "ref": &"", "cost": 1, "needs": &"", "branch": "blade", "text": "Every battle won in the wild area gives 1 ore.", "effects": {"wild_ore": 1}}, {"id": &"twin_grip", "stage": 1, "name": "Twin Grip", "kind": "perk", "ref": &"", "cost": 2, "needs": &"weapon_rack", "branch": "blade", "text": "Every weapon is used twice per battle.", "effects": {"weapon_uses": 2}}, {"id": &"second_rack", "stage": 1, "name": "Second Rack", "kind": "perk", "ref": &"", "cost": 1, "needs": &"", "branch": "blade", "text": "One more tamer slot that only a weapon fills.", "effects": {"weapon_slot": 1}}, {"id": &"pill_pouch", "stage": 0, "name": "Pill Pouch", "kind": "perk", "ref": &"", "cost": 2, "needs": &"", "branch": "cauldron", "text": "One more tamer slot that only a pill fills.", "effects": {"pill_slot": 1}}, {"id": &"herb_sense", "stage": 0, "name": "Herb Sense", "kind": "perk", "ref": &"", "cost": 1, "needs": &"", "branch": "cauldron", "text": "A harvest gives 1 more material.", "effects": {"harvest": 1}}, {"id": &"lasting_dose", "stage": 1, "name": "Lasting Dose", "kind": "perk", "ref": &"", "cost": 2, "needs": &"pill_pouch", "branch": "cauldron", "text": "The first pill you take in a battle is not used up.", "effects": {"pill_keep": 1}}, {"id": &"second_pouch", "stage": 1, "name": "Second Pouch", "kind": "perk", "ref": &"", "cost": 1, "needs": &"", "branch": "cauldron", "text": "One more tamer slot that only a pill fills.", "effects": {"pill_slot": 1}}]
