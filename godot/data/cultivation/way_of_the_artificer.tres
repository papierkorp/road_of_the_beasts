[gd_resource type="Resource" script_class="CultivationDef" format=3]

[ext_resource type="Script" path="res://overworld/core/cultivation_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"way_of_the_artificer"
display_name = "Way of the Artificer"
blurb = "You fight with tools of your own: tamer skills that work with the weapons and pills you carry. Blade: a weapon used again or laid further. Cauldron: a pill that reaches more monsters or acts again."
branches = [{"id": "blade", "name": "Blade", "text": "the weapons of the forge"}, {"id": "cauldron", "name": "Cauldron", "text": "pills taken in the battle"}]
nodes = [{"id": &"whetstone", "stage": 0, "name": "Whetstone", "kind": "tamer", "ref": &"whetstone", "cost": 1, "needs": &"", "branch": "blade"}, {"id": &"long_reach", "stage": 1, "name": "Long Reach", "kind": "tamer", "ref": &"long_reach", "cost": 2, "needs": &"", "branch": "blade"}, {"id": &"shared_dose", "stage": 0, "name": "Shared Dose", "kind": "tamer", "ref": &"shared_dose", "cost": 1, "needs": &"", "branch": "cauldron"}, {"id": &"second_dose", "stage": 1, "name": "Second Dose", "kind": "tamer", "ref": &"second_dose", "cost": 2, "needs": &"", "branch": "cauldron"}]
