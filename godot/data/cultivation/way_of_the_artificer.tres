[gd_resource type="Resource" script_class="CultivationDef" format=3]

[ext_resource type="Script" path="res://overworld/core/cultivation_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"way_of_the_artificer"
display_name = "Way of the Artificer"
blurb = "The board is your weapon. The battles of the wild drop parts of a battleground: in the wild you lay them on the board before each battle, in the void you fight on a battleground you built. You have no tamer skills and no pills."
branches = [{"id": "foundry", "name": "Foundry", "text": "more parts laid before a battle of the wild"}, {"id": "domain", "name": "Domain", "text": "a larger budget for your own battleground"}]
nodes = [{"id": &"carry_0", "stage": 0, "name": "Wider Pack", "kind": "perk", "text": "You lay one more part before each battle of the wild.", "effects": {"carry": 1}, "cost": 1, "needs": &"", "branch": "foundry"}, {"id": &"carry_1", "stage": 1, "name": "Porter's Frame", "kind": "perk", "text": "You lay one more part before each battle of the wild.", "effects": {"carry": 1}, "cost": 2, "needs": &"", "branch": "foundry"}, {"id": &"carry_2", "stage": 2, "name": "Field Foundry", "kind": "perk", "text": "You lay one more part before each battle of the wild.", "effects": {"carry": 1}, "cost": 2, "needs": &"", "branch": "foundry"}, {"id": &"carry_3", "stage": 3, "name": "Marching Kiln", "kind": "perk", "text": "You lay one more part before each battle of the wild.", "effects": {"carry": 1}, "cost": 2, "needs": &"", "branch": "foundry"}, {"id": &"domain_0", "stage": 0, "name": "Staked Ground", "kind": "perk", "text": "3 more budget for your own battleground.", "effects": {"bg_budget": 3}, "cost": 1, "needs": &"", "branch": "domain"}, {"id": &"domain_1", "stage": 1, "name": "Walled Ground", "kind": "perk", "text": "3 more budget for your own battleground.", "effects": {"bg_budget": 3}, "cost": 2, "needs": &"", "branch": "domain"}, {"id": &"domain_2", "stage": 2, "name": "Rooted Ground", "kind": "perk", "text": "3 more budget for your own battleground.", "effects": {"bg_budget": 3}, "cost": 2, "needs": &"", "branch": "domain"}, {"id": &"domain_3", "stage": 3, "name": "Sovereign Ground", "kind": "perk", "text": "3 more budget for your own battleground.", "effects": {"bg_budget": 3}, "cost": 2, "needs": &"", "branch": "domain"}]
