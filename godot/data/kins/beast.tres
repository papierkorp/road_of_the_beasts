[ext_resource type="Script" path="res://shared/kin_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"beast"
display_name = "Beast"
trait_name = "Follow-up"
trait_text = "After its Strike pushed a monster, it may enter the square that monster left, free of AP and Stamina."
