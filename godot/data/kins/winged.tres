[gd_resource type="Resource" script_class="KinDef" format=3]

[ext_resource type="Script" path="res://shared/kin_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"winged"
display_name = "Winged"
trait_name = "Aloft"
trait_text = "Ground does not act on it on entering or leaving; end-of-turn ground and traps act as usual."
trait_flags = {"ignores_ground_moments": ["enter", "leave"]}
learns = PackedStringArray("movement", "self", "ground", "zone")
gifts = Array[Dictionary]([{"id": &"updraft", "name": "Updraft", "text": "its movement passes over props", "flags": {"phasing": true}}, {"id": &"dive", "name": "Dive", "text": "in a turn in which it moved 3 or more squares its Basic Jab also pushes 1"}, {"id": &"featherlight", "name": "Featherlight", "text": "no collision damage from the board edge"}])
