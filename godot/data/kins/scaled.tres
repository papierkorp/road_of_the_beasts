[gd_resource type="Resource" script_class="KinDef" format=3]

[ext_resource type="Script" path="res://shared/kin_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"scaled"
display_name = "Scaled"
trait_name = "Armoured"
trait_text = "Takes no collision damage when it is the one moved."
trait_flags = {"reduces_damage": ["collision_self"], "reduction": 2}
