[gd_resource type="Resource" script_class="GroundDef" format=3]

[ext_resource type="Script" path="res://battle/defs/ground_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"no_prop"
display_name = "No-Prop Ground"
battle = "multiplayer"
no_props = true
color = Color(0.78, 0.7, 0.48, 1)
description = "No prop can be placed here. A prop that already stands where it is laid, or is pushed onto it, stays. It does nothing to monsters."
