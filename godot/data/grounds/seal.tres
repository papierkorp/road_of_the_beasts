[gd_resource type="Resource" script_class="GroundDef" format=3]

[ext_resource type="Script" path="res://battle/defs/ground_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"seal"
display_name = "Seal Ground"
battle = "ingame"
immutable = true
color = Color(0.62, 0.3, 0.78, 1)
pattern = "seal"
description = "Laid by a tamer. A wild monster that ends its turn on it may be caught (a chance by its HP); a wild monster that falls to 0 HP on it is caught. Nothing changes this ground; it lies until it catches or the battle ends."
