": "Every monster you own, now and later, has one more slot.", "price": "One place less in every team (at least one).", "effects": {"slot_all": true, "team": -1}}, {"id": &"bare_hand", "name": "Vow of the Bare Hand", "gain": "One more tamer slot.", "price": "You forge and carry no weapon.", "effects": {"tamer_slots": 1, "no_weapons": true}}, {"id": &"ascetic", "name": "Vow of the Ascetic", "gain": "Your monsters regain 1 HP after every battle won in a dungeon.", "price": "You brew and use no pill.", "effects": {"dungeon_heal": 1, "no_pills": true}}, {"id": &"no_seal", "name": "Vow without Seal", "gain": "Every battle won in the wild area leaves an egg.", "price": "You lose Seal and never catch again.", "effects": {"wild_egg": true, "no_seal": true}}, {"id": &"short_life", "name": "Vow of the Short Life", "gain": "1 more AP every year.", "price": "Every lifespan is 2 years shorter, this one too.", "effects": {"ap": 1, "lifespan": -2}}, {"id": &"still_ground", "name": "Vow of the Still Ground", "gain": "4 more budget for your battleground.", "price": "No zone on your battleground.", "effects": {"bg_budget": 4, "no_zones": true}}, {"id": &"open_sky", "name": "Vow of the Open Sky", "gain": "A Dragon Vein counts 1 toward the budget of your battleground.", "price": "No prop on your battleground.", "effects": {"vein_weight": 1, "no_props": true}}, {"id": &"call_of_the_void", "name": "Call of the Void", "gain": "Every trial leaves two void eggs.", "price": "No more eggs from the wild area.", "effects": {"void_eggs": 2, "no_wild_eggs": true}}]
